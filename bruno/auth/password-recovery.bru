{
  "name": "HelpDesk API - Password Recovery",
  "version": "1.0.0",
  "description": "Requests para recuperación y restablecimiento de contraseña",
  "requests": [
    {
      "name": "1. Solicitar Código de Recuperación (Forgot Password)",
      "method": "POST",
      "url": "http://localhost:5000/api/auth/forgot-password",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "juan.perez@empresa.com"
      }
    },
    {
      "name": "2. Restablecer Contraseña (Reset Password)",
      "method": "POST",
      "url": "http://localhost:5000/api/auth/reset-password",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "juan.perez@empresa.com",
        "codigo": "123456",
        "nuevaPassword": "NuevaPassword123!"
      }
    }
  ]
}
